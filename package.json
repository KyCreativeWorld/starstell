{
  "name": "starstell",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "expo": "~58.0.23",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "pako": "^2.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "node scripts/gen-audit-materials.mjs && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/gen-audit-materials.mjs && expo start --web",
    "build:web": "expo export --platform web",
    "build:html": "node scripts/gen-audit-materials.mjs && node scripts/build-html.mjs",
    "lint": "expo lint",
    "gen:audit": "node scripts/gen-audit-materials.mjs"
  },
  "private": true
